# ============================================
# 生产环境配置文件
# ============================================
# 复制此文件为 .env.production 并填入真实值
# 复制命令: cp .env.production.example .env.production

# ============================================
# 生产安全与数据库配置（必须设置）
# ============================================
# 生成随机密钥：openssl rand -base64 32
PG_PASSWORD=replace_with_a_strong_postgres_password
DATABASE_URL=postgresql://content_monitor:replace_with_a_strong_postgres_password@localhost:5432/content_monitor_db
DB_ENCRYPTION_KEY=replace_with_random_encryption_key
PASSWORD_HASH_SALT=replace_with_random_password_salt
AUTH_COOKIE_SECRET=replace_with_random_cookie_secret
# 启用后台 worker API 时必须设置
INTERNAL_WORKER_TOKEN=replace_with_random_worker_token

# 警告：修改 DB_ENCRYPTION_KEY 后，之前加密的数据将无法解密。

# ============================================
# 微信公众号 API 配置 (必须设置)
# ============================================
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret
WECHAT_AUTHOR=默认作者名称

# ============================================
# LLM API Keys
# ============================================
# MiniMax
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_GROUP_ID=your_minimax_group_id

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key

# OpenAI (可选)
OPENAI_API_KEY=your_openai_api_key

# ============================================
# 图片源 API Keys
# ============================================
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
PEXELS_API_KEY=your_pexels_api_key

# ============================================
# 搜索服务 API Keys
# ============================================
EXA_API_KEY=your_exa_api_key
TAVILY_API_KEY=your_tavily_api_key
TIANGONG_API_KEY=your_tiangong_api_key

# ============================================
# 可选运行策略
# ============================================
# 仅在演示环境显式开启；生产默认应保持 false
ALLOW_DEMO_DATA=false
