{
  "name": "content-monitor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "bash scripts/verify.sh"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "tsx": {
      "esbuild": "0.28.2"
    },
    "postcss": "8.5.26"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "docx": "^9.6.1",
    "dompurify": "^3.4.5",
    "drizzle-orm": "^0.45.2",
    "jszip": "^3.10.1",
    "marked": "^17.0.5",
    "next": "^16.3.1",
    "pg": "^8.20.0",
    "playwright": "1.62.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "segmentit": "^2.0.3",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.0.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
